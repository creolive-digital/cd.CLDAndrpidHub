<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CLD Android Hub</AssemblyName>
    <AssemblyTitle>CLD Android Hub</AssemblyTitle>
    <Product>CLD Android Hub</Product>
    <Version>2.1.0</Version>
    <ApplicationIcon>BrandAssets\cld-hub.ico</ApplicationIcon>
    <Company>CLD</Company>
    <Description>Connect to and control Android phones from Windows.</Description>
    <RootNamespace>AndroidHub</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="RuntimeAssets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
      <Content Include="BrandAssets\*.png;BrandAssets\*.ico;BrandAssets\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="README.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
